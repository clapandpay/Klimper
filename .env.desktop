# Klimper release flags for the desktop builds (macOS, Linux, Windows): `vite build --mode
# desktop` reads this file, through `pnpm run build:desktop`, the beforeBuildCommand of
# src-tauri/tauri.{macos,linux,windows}.conf.json. Every feature is on: the desktop app is the
# full wallet, with offers, options, swap and the Apps screen. The phone builds read
# .env.production instead. Every flag is set here, on or off, so a developer's .env never
# decides a release. Committed on purpose; no secrets here, ever.

VITE_DISABLE_OFFERS=false
VITE_DISABLE_OPTIONS=false
VITE_DISABLE_SWAP=false
VITE_DISABLE_NFTS=false
VITE_DISABLE_NFT_MINTING=false
VITE_DISABLE_PROFILES=false
VITE_DISABLE_TOKEN_ISSUING=false
VITE_DISABLE_WALLETCONNECT=false
VITE_DISABLE_RPC_SETTINGS=false
VITE_DISABLE_THEME_GALLERY=false
VITE_DISABLE_SCAN=false

# Send to "@anna" (XCHandles, mainnet only).
VITE_ENABLE_HANDLES=true
# dApp connections over Xchonnect.
VITE_ENABLE_XCHONNECT=true
# The Klimper coins: the coin sound, haptics and the coin pouch (TASK-111, TASK-124).
VITE_ENABLE_KLIMPER_COINS=true
# Partial offers (CHIP-0052, TASK-164): off until tried on testnet.
VITE_ENABLE_PARTIAL_OFFERS=false
