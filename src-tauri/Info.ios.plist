<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Klimper's iOS-only Info.plist keys; Tauri merges this over Info.plist for iOS builds.
     The scene manifest belongs to Sources/sage-tauri/KlimperScene.m in gen/apple. -->
<plist version="1.0">
    <dict>
        <!-- No ITSAppUsesNonExemptEncryption yet (TASK-090). Klimper implements standard
             algorithms itself, but `true` makes App Store Connect refuse every upload until
             export documentation is approved and its code is in ITSEncryptionExportComplianceCode;
             `false` claims an exemption nobody has confirmed. Until TASK-090 decides, each build
             answers the export question in App Store Connect. -->
        <!-- The Xchonnect pairing URI (`xchonnect:v1?r=…&s=…`, spec 6.2) opens Klimper from any
             website, with no hosting on our side; a dApp's SDK uses it before a wallet has
             announced a link base. Universal links (applinks:clapandpay.com) are in the
             entitlements. Hand-maintained on purpose: tauri-plugin-deep-link's own config would
             rewrite the hand-maintained entitlements (docs/xchonnect-links.md). -->
        <key>CFBundleURLTypes</key>
        <array>
            <dict>
                <key>CFBundleURLName</key>
                <string>com.clapandpay.klimper.xchonnect</string>
                <key>CFBundleURLSchemes</key>
                <array>
                    <string>xchonnect</string>
                </array>
                <key>CFBundleTypeRole</key>
                <string>Viewer</string>
            </dict>
        </array>
        <key>UIApplicationSceneManifest</key>
        <dict>
            <key>UIApplicationSupportsMultipleScenes</key>
            <false/>
            <key>UISceneConfigurations</key>
            <dict>
                <key>UIWindowSceneSessionRoleApplication</key>
                <array>
                    <dict>
                        <key>UISceneConfigurationName</key>
                        <string>Default Configuration</string>
                        <key>UISceneDelegateClassName</key>
                        <string>KlimperSceneDelegate</string>
                    </dict>
                </array>
            </dict>
        </dict>
    </dict>
</plist>
