{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "klimper-capability",
  "description": "Klimper: Xchonnect dApp connections (bringing the window forward for a request), for the main webview only (never app webviews)",
  "webviews": ["main"],
  "permissions": [
    "klimper-xchonnect:default",
    "klimper-jingle:default",
    "deep-link:default",
    "core:window:allow-set-focus",
    "core:window:allow-unminimize",
    "core:window:allow-show",
    "core:window:allow-request-user-attention"
  ]
}
