{
  "productName": "Sage",
  "version": "0.13.1",
  "identifier": "com.rigidnetwork.sage",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm run dev",
    "beforeBuildCommand": "pnpm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Sage",
        "width": 1150,
        "height": 750,
        "resizable": true,
        "maximized": false,
        "visible": true,
        "titleBarStyle": "Transparent"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' https: http: data: blob:",
        "media-src": "'self' https: http: data: blob:",
        "font-src": "'self' https: data:",
        "connect-src": "'self' ipc: http://ipc.localhost https: wss://relay.walletconnect.org",
        "object-src": "'none'",
        "frame-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../builtin-apps/build/dist": "builtin-apps"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "iOS": {
      "developmentTeam": "NQJQRYZZG3"
    }
  },
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json"
}
