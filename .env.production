# Klimper release flags: `vite build` (TestFlight, App Store) reads this file and
# it wins over .env, so a developer's local settings never reach a release. Committed on
# purpose (git add -f); no secrets here, ever. `vite dev` ignores it and reads .env.

# The reduced interface: the wallet primitives only.
VITE_DISABLE_OFFERS=true
VITE_DISABLE_OPTIONS=true
VITE_DISABLE_SWAP=true
VITE_DISABLE_NFTS=true
VITE_DISABLE_PROFILES=true
VITE_DISABLE_TOKEN_ISSUING=true
VITE_DISABLE_WALLETCONNECT=true
VITE_DISABLE_RPC_SETTINGS=true
VITE_DISABLE_THEME_GALLERY=true

# Send to "@anna" (XCHandles, mainnet only).
VITE_ENABLE_HANDLES=true

# dApp connections over Xchonnect. App Review needs a website to pair with: give one, and
# the steps, in the review notes.
VITE_ENABLE_XCHONNECT=true

# "Use my Clap and Pay money" opens envelope.clapandpay.com, which does not serve the handoff page yet
# (2026-10-05). A button that leads nowhere fails App Review 2.1: off until the page is live,
# then delete this line.
VITE_DISABLE_CLAPANDPAY_CONNECT=true
# The page is the Green Envelope app. Its passkey still belongs to clapandpay.com (RP_ID in
# tauri-plugin-klimper-passkey); only the host that serves the handoff page moved.
VITE_CLAPANDPAY_ORIGIN=https://envelope.clapandpay.com
