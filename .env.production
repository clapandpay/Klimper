# Klimper release flags. Vite reads this file for every production build (`vite build`, so
# `tauri build`, `tauri ios build` and scripts/testflight.sh) and never for `pnpm dev`, which
# reads .env and .env.local. It holds no secrets and never should.
#
# Klimper shows the wallet primitives only: assets, send, receive, addresses, coins,
# transactions, peers and settings. Everything below still exists in the engine. The App Store
# listing says Klimper offers no trading, exchange or mining (guideline 3.1.5), so the offer,
# option and swap screens stay off in every release build.
VITE_DISABLE_OFFERS=true
VITE_DISABLE_OPTIONS=true
VITE_DISABLE_SWAP=true
VITE_DISABLE_NFTS=true
VITE_DISABLE_PROFILES=true
VITE_DISABLE_TOKEN_ISSUING=true
VITE_DISABLE_WALLETCONNECT=true
VITE_DISABLE_RPC_SETTINGS=true
VITE_DISABLE_THEME_GALLERY=true

# Send to "@anna" instead of an address (XCHandles, mainnet only).
VITE_ENABLE_HANDLES=true

# "Use my Clap and Pay money" on the start screen. VITE_CLAPANDPAY_ORIGIN is deliberately unset:
# releases talk to https://clapandpay.com, the default in src/lib/features.ts.
VITE_ENABLE_CLAPANDPAY_CONNECT=true

# dApp connections over Xchonnect (decision-008), as .env.example ships them. Its security
# review is TASK-094: set this to false if a release has to go out before that review.
VITE_ENABLE_XCHONNECT=true
