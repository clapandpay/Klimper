# Klimper release flags for the phone builds (iOS: TestFlight and the App Store; Android):
# `vite build` reads this file through `pnpm run build:frontend`, the beforeBuildCommand of
# src-tauri/tauri.{ios,android}.conf.json, and it wins over .env, so a developer's local
# settings never reach a release. The desktop builds read .env.desktop instead. Committed on
# purpose (git add -f); no secrets here, ever. `vite dev` ignores it and reads .env.

# Everything is on, offers too (since 1.2.0). The Apps screen is not shown on a phone either:
# Sage hides it there (Nav.tsx, `supportsSageApps`), so it needs no flag here.
# App Review: offers, options and swap are trading features (guideline 3.1.5); say what they
# do in the review notes. With offers come MintGarden links and "Add to Offer": check them
# against guideline 3.1.1 (no route to buying outside in-app purchase).
VITE_DISABLE_OFFERS=false
VITE_DISABLE_OPTIONS=false
VITE_DISABLE_SWAP=false
VITE_DISABLE_NFTS=false
VITE_DISABLE_NFT_MINTING=false
VITE_DISABLE_PROFILES=false
VITE_DISABLE_TOKEN_ISSUING=false
VITE_DISABLE_WALLETCONNECT=false
VITE_DISABLE_RPC_SETTINGS=false
VITE_DISABLE_THEME_GALLERY=false
VITE_DISABLE_SCAN=false

# Send to "@anna" (XCHandles, mainnet only).
VITE_ENABLE_HANDLES=true

# dApp connections over Xchonnect. App Review needs a website to pair with: give one, and
# the steps, in the review notes.
VITE_ENABLE_XCHONNECT=true
# The Klimper sound: a coin jingle when coins arrive or the phone is shaken (TASK-111).
VITE_ENABLE_KLIMPER_COINS=true

# Partial offers (TASK-164, CHIP-0052): on, tried on testnet11. They need offers.
VITE_ENABLE_PARTIAL_OFFERS=true
