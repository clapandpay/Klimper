# Klimper's push gateway, compiled into every build that has no KLIMPER_PUSH_GATEWAY_* in
# the environment and no .push-dev.env (tauri-plugin-klimper-xchonnect/build.rs, docs/push.md).
# Both values are public: the wake URL as the relay calls it, and the gateway's X25519
# public key from GET /v1/keys (base64url). The gateway runs at push.clapandpay.com as a ONCE
# app on the nodexch server (nodexch docs/operations.md, "Xchonnect"; TASK-086); the matching
# secret is in the server's .env as XCHONNECT_GATEWAY_KEYS. Rotation: a new key goes first in
# XCHONNECT_GATEWAY_KEYS, the old one stays behind it until every build with it is gone.
KLIMPER_PUSH_GATEWAY_URL=https://push.clapandpay.com/v1/wake
KLIMPER_PUSH_GATEWAY_KEY=zgZ-Y-7voSta-lsbeH51bygLmJq-01J2J1KhM7IxDFo
