# Klimper's push gateway, compiled into every build that has no KLIMPER_PUSH_GATEWAY_* in
# the environment and no .push-dev.env (tauri-plugin-klimper-xchonnect/build.rs, docs/push.md).
# Both values are public: the wake URL as the relay calls it, and the gateway's X25519
# public key from GET /v1/keys (base64url). Empty until the gateway runs (TASK-086); then
# push is off and the app polls while it is open.
KLIMPER_PUSH_GATEWAY_URL=
KLIMPER_PUSH_GATEWAY_KEY=
