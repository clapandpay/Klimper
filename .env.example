# Klimper development flags: copy to .env for `pnpm dev`. Release builds read their own file,
# which wins over .env: .env.production on the phones, .env.desktop on macOS, Linux and Windows.
# Committed on purpose (git add -f): no secrets here, ever; put anything private in .env.local,
# which git ignores.
#
# Klimper shows the wallet primitives only: assets, NFTs, send, receive, addresses, coins,
# transactions, peers, settings, and the Apps screen with its bridge approval dialogs.
# Everything below still exists in the engine, so installed apps can use it through the bridge.
# Set a line to false (or delete it) to bring the screen back.
VITE_DISABLE_OFFERS=true
VITE_DISABLE_OPTIONS=true
VITE_DISABLE_SWAP=true
VITE_DISABLE_NFT_MINTING=true
VITE_DISABLE_PROFILES=true
VITE_DISABLE_TOKEN_ISSUING=true
VITE_DISABLE_WALLETCONNECT=true
VITE_DISABLE_RPC_SETTINGS=true
VITE_DISABLE_THEME_GALLERY=true

# Send to "@anna" instead of an address (XCHandles, mainnet only). Off unless set to true.
VITE_ENABLE_HANDLES=true

# dApp connections over Xchonnect: pairing, the six-digit code and signing requests from
# outside websites (decision-008).
VITE_ENABLE_XCHONNECT=true
# The Klimper sound: a coin jingle when coins arrive or the phone is shaken (TASK-111).
VITE_ENABLE_KLIMPER_COINS=true
